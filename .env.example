# =============================================================================
# Universal RAG Enterprise — environment template
#
# Local dev  → copy to .env, fill in keys, run docker-compose up
# Production → secrets are stored in GCP Secret Manager by deploy_gcp.sh;
#              do NOT commit a filled-in .env to source control
# =============================================================================

# ── LLM provider ──────────────────────────────────────────────────────────────
# "groq"     → Groq Llama (local dev / CI)
# "vertexai" → Vertex AI Claude (production on Cloud Run — no API key needed,
#               uses the Cloud Run service account via ADC)
LLM_PROVIDER=groq

# ── Groq (used when LLM_PROVIDER=groq) ───────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Vertex AI Claude (used when LLM_PROVIDER=vertexai) ───────────────────────
# VERTEXAI_PROJECT is set automatically by deploy_gcp.sh on Cloud Run.
# Fill these in only if running Vertex AI locally with user credentials.
VERTEXAI_PROJECT=your_gcp_project_id
VERTEXAI_LOCATION=us-east5
VERTEXAI_MODEL=claude-sonnet-4-5@20251205

# ── Search & Reranking ────────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_generated_jwt_secret_here

# ── Pinecone — managed vector DB (replaces self-hosted ChromaDB) ──────────────
# 1. Create a free account at https://www.pinecone.io
# 2. Run: python scripts/create_pinecone_index.py
#    (or let the app create it automatically on first start)
# Index spec: dimension=384, metric=cosine  (matches all-MiniLM-L6-v2)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=universal-rag

# ── PostgreSQL — Cloud SQL in production, local container for dev ──────────────
# Local dev  : leave blank — docker-compose defaults to the local postgres container
# Production : set by deploy_gcp.sh →
#   postgresql://raguser:PASSWORD@/ragdb?host=/cloudsql/PROJECT:REGION:rag-postgres
DATABASE_URL=

# ── Redis — Memorystore in production, local container for dev ────────────────
# Local dev  : leave blank — docker-compose defaults to the local redis container
# Production : set by deploy_gcp.sh → redis://MEMORYSTORE_IP:6379/0
REDIS_URL=
