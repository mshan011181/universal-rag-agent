# Copy this file to .env.local and fill in values
# frontend/.env.local is gitignored — never committed

# Points the Next.js UI at the FastAPI backend
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (Cloud Run URL — set automatically by deploy_gcp.sh):
# NEXT_PUBLIC_API_URL=https://rag-api-xxxx-uc.a.run.app
